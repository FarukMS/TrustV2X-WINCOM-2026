<?xml version="1.0" encoding="UTF-8"?>

<configuration>
    <input>
        <net-file value="../network/trustv2x_grid.net.xml"/>
        <route-files value="../routes/trustv2x_routes.rou.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="670"/>
        <step-length value="1"/>
    </time>

    <processing>
        <time-to-teleport value="-1"/>
    </processing>

    <report>
        <verbose value="false"/>
        <no-step-log value="true"/>
    </report>
</configuration>
