<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <input>
        <net-file value="../network/trustv2x_2x2_signalised.net.xml"/>
        <route-files value="../routes/trustv2x_2x2_signalised.rou.xml"/>
        <additional-files value="../additional/trustv2x_2x2_signalised.add.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="360"/>
        <step-length value="1"/>
    </time>

    <processing>
        <time-to-teleport value="-1"/>
        <collision.action value="warn"/>
    </processing>

    <report>
        <verbose value="true"/>
        <no-step-log value="true"/>
    </report>

</configuration>
